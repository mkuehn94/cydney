# copy to deploy/.env
CYD_DOMAIN=cydney.example.com
CYD_EMAIL=you@example.com
CYD_AUTH_USER=cydney
# docker run --rm -it caddy:2-alpine caddy hash-password
# keep the single quotes!! the hash has $ in it
CYD_AUTH_HASH='$2a$14$replace_with_generated_hash'

CYD_FEEDS=1
CYD_TILES=1
CYD_FEED_USER_AGENT="Cydney/1.0 (mailto:you@example.com)"
CYD_TILE_USER_AGENT="Cydney/1.0 (mailto:you@example.com)"

# optional, rest of the transit settings is in ../.env.example
# CYD_TRANSIT_VP_URL=https://operator.example/vehicle-positions.pb
# CYD_TRANSIT_VP_ATTRIBUTION="Operator / license"
