# copy to .env and start with:
# uv run uvicorn server.app:app --host 127.0.0.1 --port 8000 --env-file .env
# (npm run server does not load .env)
CYD_MODE=live
CYD_FEEDS=1
CYD_TILES=1
CYD_FEED_CACHE=.cache/feeds
CYD_ATP_FILE=.cache/imports/alltheplaces.geojson

# set these if you host it somewhere
# CYD_FEED_USER_AGENT="Cydney/0.4 (https://your-project.example/contact)"
# CYD_TILE_USER_AGENT="Cydney/0.4 (https://your-project.example/contact)"

# GTFS-RT vehicle positions, url + attribution are both needed
# CYD_TRANSIT_VP_URL=https://operator.example/gtfs-rt/vehicle-positions.pb
# CYD_TRANSIT_VP_ATTRIBUTION="Operator name / published license"
# CYD_TRANSIT_VP_NAME="Operator name"
# bounds as W/S/E/N, default is munich
# CYD_TRANSIT_VP_BOUNDS=[10.3,47.5,12.7,49.0]
# CYD_TRANSIT_VP_TOKEN=...
